# Gemini API Key (for AI Studio integration)
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Server URL (set this to your Railway deployment URL in production)
# Leave blank for local development (defaults to http://localhost:3001)
# Example: https://your-app.up.railway.app
VITE_LLM_API_URL=

# API Secret Key (must match the API_SECRET set in Railway)
# Generate a strong random string: openssl rand -hex 32
# REQUIRED for production deployment
VITE_API_SECRET=your_secret_key_here
