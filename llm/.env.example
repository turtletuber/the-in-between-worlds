# Security: API Secret Key (REQUIRED for production)
# Generate a strong random string: openssl rand -hex 32
# Set this in Railway and Vercel environments
API_SECRET=your_secret_key_here

# Ollama Configuration (for local models)
OLLAMA_HOST=http://localhost:11434
MODEL_NAME=qwen2.5:7b

# Optional: Gemini API (for fast cloud inference)
# GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Replicate API (fallback when Ollama is unavailable)
# Get your API key from https://replicate.com/account/api-tokens
# REPLICATE_API_KEY=your_replicate_api_key_here

# Optional: Remote Ollama hosts
# RASPI_HOST=http://your-pi-ip:11434
